        <job>OCA\Keepiq\BackgroundJob\EphemeralSendPurgeJob</job>
        <job>OCA\Keepiq\BackgroundJob\RefreshComplianceMetricsJob</job>
        <job>OCA\Keepiq\BackgroundJob\DeliverSiemEventsJob</job>
        <job>OCA\Keepiq\BackgroundJob\ScanCertificateExpiryJob</job>
    </background-jobs>

    <!--
        ORDERING: the two Migrate* steps come FIRST in both lists.

        The doriath -> keepiq rename is not an upgrade as far as Nextcloud is
        concerned — `oc_appconfig.appid` and `oc_preferences.appid` are both
        namespaced by app id, so the new id simply cannot see anything the old
        id stored. MigrateAppConfigKeys and MigrateUserPreferences copy those
        two stores across, and they must run before any step that READS
        configuration, or that step will act on defaults and then persist them:

          - BootstrapCertificateAuthority reads the `ca_status` app-config
            value; without the copy it sees a blank status on an instance that
            already has a live CA in `keepiq_ca_certs`.
          - InitializeSettings seeds DEFAULT_CONFIG into any key that reads
            back empty — i.e. it would overwrite the admin's real settings with
            defaults if the copy had not happened yet.

        They are registered under <install> as well as <post-migration> because
        <install> is the path a real deployment takes: Nextcloud discovers
        `keepiq` as a DIFFERENT app, not as an upgrade of `doriath`, so only
        the install path is guaranteed to run.
    -->
    <repair-steps>
        <!--
            RenameDoriathTables runs PRE-migration, and that is deliberate.

            Unlike the app-id rename above, the table rename lands as an
            ORDINARY UPGRADE of `keepiq` - same app id, new version - so
            Installer::installAppLastSteps() takes the `$previousVersion !== ''`
            branch and runs pre-migration steps BEFORE MigrationService::migrate().
            That ordering is what makes a partially-migrated install work: the
            old tables an install actually has are renamed first, and any
            migration that has not run yet then creates the rest under the new
            name.

            It is NOT registered under <install>. Install-path repair runs AFTER
            the migrations, by which point they have already created empty
            keepiq_* tables, so the step could only refuse. A genuinely fresh
            install needs no rename anyway - the migrations create the new names
            directly - and an instance where the separate `doriath` APP is still
            installed must keep its tables, which the step's refuse-on-collision
            behaviour guarantees.
        -->
        <pre-migration>
            <step>OCA\Keepiq\Repair\RenameDoriathTables</step>
            <step>OCA\Keepiq\Repair\MoveAttachmentBlobs</step>
        </pre-migration>
        <post-migration>
            <step>OCA\Keepiq\Repair\MigrateAppConfigKeys</step>
            <step>OCA\Keepiq\Repair\MigrateUserPreferences</step>
            <!--
                THE THIRD STORE KEYED BY APP ID, AND THE TWO ABOVE DO NOT COVER
                IT. `oc_appconfig` and `oc_preferences` are Nextcloud's; this
                one is OpenRegister's `openregister_schemas.application`.

                OpenRegister resolves the two halves of a configuration by
                DIFFERENT keys: a REGISTER by slug alone, a SCHEMA by the PAIR
                (application, slug) via findByApplicationAndSlug(). This app now
                passes `appId: Application::APP_ID` = `keepiq`, while every
                schema it already owns still carries `application = doriath` —
                so the pair matches nothing, and ImportHandler's not-found
                branch is not an error path, it is the "create a new one" path.
                The import then builds a SECOND, EMPTY schema set while every
                stored secret stays bound to the old rows. Nothing errors; the
                app renders empty collections.

                MUST stay ahead of InitializeSettings, which is what triggers
                that import via SettingsService.

                Refuses rather than merges where a slug already has a twin under
                the new application id, never deletes a schema, and never
                throws — an escaping exception in <install> aborts the install.
            -->
            <step>OCA\Keepiq\Repair\MigrateSchemaApplicationId</step>
            <step>OCA\Keepiq\Repair\BootstrapCertificateAuthority</step>
            <step>OCA\Keepiq\Repair\InitializeSettings</step>
            <step>OCA\Keepiq\Repair\SeedSecretTypes</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentData</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentSecrets</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentApplications</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentSecretRequests</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentLinkShares</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentShares</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentSecretDelegations</step>
        </post-migration>
        <install>
            <step>OCA\Keepiq\Repair\MigrateAppConfigKeys</step>
            <step>OCA\Keepiq\Repair\MigrateUserPreferences</step>
            <!-- Same step, same reason, same position ahead of
                 InitializeSettings; see the <post-migration> block. An app-id
                 rename presents to Nextcloud as a FRESH INSTALL, so this block
                 is the one that actually fires on the upgrade it exists for. -->
            <step>OCA\Keepiq\Repair\MigrateSchemaApplicationId</step>
            <step>OCA\Keepiq\Repair\BootstrapCertificateAuthority</step>
            <step>OCA\Keepiq\Repair\InitializeSettings</step>
            <step>OCA\Keepiq\Repair\SeedSecretTypes</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentData</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentSecrets</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentApplications</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentSecretRequests</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentLinkShares</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentShares</step>
            <step>OCA\Keepiq\Repair\SeedDevelopmentSecretDelegations</step>
        </install>
    </repair-steps>

